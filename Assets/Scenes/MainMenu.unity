      m_Calls: []
  m_text: "<b>Hi!</b>\nWe are the <b>BCI Busters</b>, and we need your help to clear
    the path!\nTeam up with a buddy to beat the clock:\n\u2022  <b>BCI Player:</b>
    Focus on the flashing targets to cycle through Noelle, Ralsei, and Susie.\n\u2022 
    <b>Keyboard Player:</b> Move Kris with W / A / S / D and press SPACE to lock
    in their power.\nYou can also take on the challenge alone in single-player!\n<b>The
    faster you finish, the higher your score multiplier!</b>"
  m_isRightToLeft: 0
